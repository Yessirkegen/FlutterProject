platform :ios, '13.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # ...тот же код, что был у вас...
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # <-- ключевая строка: статические фреймворки
  use_frameworks! :linkage => :static

  # <-- УБИРАЕМ use_modular_headers! (если он был)
  # use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Удаляем флаг -G из любых OTHER_*FLAGS
    target.build_configurations.each do |config|
      ['OTHER_CFLAGS','OTHER_CPLUSPLUSFLAGS','OTHER_SWIFT_FLAGS','OTHER_LDFLAGS'].each do |flag|
        if config.build_settings[flag]
          config.build_settings[flag] = config.build_settings[flag]
            .split
            .reject { |f| f.start_with?('-G') }
            .join(' ')
        end
      end
      # Исключаем arm64 для симуляторов
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end
end
