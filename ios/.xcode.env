# This `.xcode.env` file is used to configure environment variables for the iOS build
DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
FLUTTER_ROOT=$HOME/flutter
FLUTTER_TARGET=lib/main.dart
FLUTTER_BUILD_MODE=debug
FLUTTER_BUILD_DIR=build
SYMROOT=${SOURCE_ROOT}/../build/ios
FLUTTER_FRAMEWORK_DIR=$FLUTTER_ROOT/bin/cache/artifacts/engine/ios
FLUTTER_BUILD_NAME=1.0.0
FLUTTER_BUILD_NUMBER=1
TRACK_WIDGET_CREATION=true
TREE_SHAKE_ICONS=false
PACKAGE_CONFIG=${SOURCE_ROOT}/.dart_tool/package_config.json
ARCHS=arm64 